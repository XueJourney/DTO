# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=

# Authentication (choose EITHER AUTH_PASSWORD or the hash + salt pair)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# AUTH_PASSWORD_SALT=
# AUTH_PASSWORD_HASH=

# Upstream provider configuration
UPSTREAM_API_URL=https://www.gpt4novel.com/api/xiaoshuoai/ext/v1/chat/completions
UPSTREAM_DEFAULT_MODEL=nalang-xl-10
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=800
DEFAULT_TOP_P=0.35
DEFAULT_REPETITION_PENALTY=1.05
# MODEL_MAPPING_JSON={"gpt-4":"custom-model"}

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dto_proxy
DB_CHARSET=utf8mb4
DB_TIMEZONE=+08:00
